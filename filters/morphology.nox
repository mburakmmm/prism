from core.errors import DimensionError, ResourceLimitError
from core.image import Image, MutableImage
from core.pixel import Pixel
from transforms.border import BorderMode, sample_with_border

MAX_MORPH_RADIUS: int = 8

def _validate_morph_radius(radius: int) -> None:
    if radius < 1:
        raise DimensionError("morphology radius must be >= 1: got " + str(radius))
    if radius > MAX_MORPH_RADIUS:
        raise ResourceLimitError("morphology radius " + str(radius) + " exceeds MAX_MORPH_RADIUS " + str(MAX_MORPH_RADIUS))

def erode(img: Image, radius: int) -> Image:
    """Morphological erosion (local minimum over (2*radius + 1) x (2*radius + 1) window)."""
    _validate_morph_radius(radius)
    w: int = img.width()
    h: int = img.height()
    const_zero: Pixel = Pixel.transparent()
    out_mut: MutableImage = MutableImage.create(w, h, img.pixel_format(), const_zero, img.limits)

    y: int = 0
    while y < h:
        x: int = 0
        while x < w:
            min_r: int = 255
            min_g: int = 255
            min_b: int = 255
            dy: int = -radius
            while dy <= radius:
                dx: int = -radius
                while dx <= radius:
                    px: Pixel = sample_with_border(img, x + dx, y + dy, BorderMode.CLAMP, const_zero)
                    if px.r < min_r:
                        min_r = px.r
                    if px.g < min_g:
                        min_g = px.g
                    if px.b < min_b:
                        min_b = px.b
                    dx = dx + 1
                dy = dy + 1
            out_mut.set_pixel(x, y, Pixel.rgba(min_r, min_g, min_b, img.get_pixel(x, y).a))
            x = x + 1
        y = y + 1

    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res

def dilate(img: Image, radius: int) -> Image:
    """Morphological dilation (local maximum over (2*radius + 1) x (2*radius + 1) window)."""
    _validate_morph_radius(radius)
    w: int = img.width()
    h: int = img.height()
    const_zero: Pixel = Pixel.transparent()
    out_mut: MutableImage = MutableImage.create(w, h, img.pixel_format(), const_zero, img.limits)

    y: int = 0
    while y < h:
        x: int = 0
        while x < w:
            max_r: int = 0
            max_g: int = 0
            max_b: int = 0
            dy: int = -radius
            while dy <= radius:
                dx: int = -radius
                while dx <= radius:
                    px: Pixel = sample_with_border(img, x + dx, y + dy, BorderMode.CLAMP, const_zero)
                    if px.r > max_r:
                        max_r = px.r
                    if px.g > max_g:
                        max_g = px.g
                    if px.b > max_b:
                        max_b = px.b
                    dx = dx + 1
                dy = dy + 1
            out_mut.set_pixel(x, y, Pixel.rgba(max_r, max_g, max_b, img.get_pixel(x, y).a))
            x = x + 1
        y = y + 1

    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res

def morphology_open(img: Image, radius: int) -> Image:
    """Morphological opening: dilate(erode(img, radius), radius) to remove bright salt noise."""
    return dilate(erode(img, radius), radius)

def morphology_close(img: Image, radius: int) -> Image:
    """Morphological closing: erode(dilate(img, radius), radius) to fill dark pepper holes."""
    return erode(dilate(img, radius), radius)
