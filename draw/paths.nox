from core.errors import DimensionError, InvalidImageError
from core.pixel import Pixel
from draw.canvas import Canvas
from draw.rasterizer import Point2D
from draw.shapes import draw_line

def draw_polyline(canvas: Canvas, points: list[Point2D], color: Pixel, thickness: int, closed: bool, antialias: bool) -> None:
    """Draw a connected sequence of line segments through `points` (closed if `closed == True`)."""
    n: int = len(points)
    if n < 2:
        raise InvalidImageError("draw_polyline requires at least 2 points")
    if thickness < 1:
        raise DimensionError("draw_polyline thickness must be >= 1")
    i: int = 0
    while i + 1 < n:
        p0: Point2D = points[i]
        p1: Point2D = points[i + 1]
        draw_line(canvas, p0.x, p0.y, p1.x, p1.y, color, thickness, antialias)
        i = i + 1
    if closed and n >= 3:
        last_pt: Point2D = points[n - 1]
        first_pt: Point2D = points[0]
        draw_line(canvas, last_pt.x, last_pt.y, first_pt.x, first_pt.y, color, thickness, antialias)

def draw_polygon(canvas: Canvas, points: list[Point2D], color: Pixel, thickness: int, antialias: bool) -> None:
    """Draw a closed polygon outline through `points`."""
    if len(points) < 3:
        raise InvalidImageError("draw_polygon requires at least 3 vertices")
    draw_polyline(canvas, points, color, thickness, True, antialias)

def draw_quadratic_bezier(canvas: Canvas, p0: Point2D, p1: Point2D, p2: Point2D, color: Pixel, thickness: int, segments: int, antialias: bool) -> None:
    """Draw a quadratic Bezier curve from `p0` to `p2` with control point `p1` subdivided into `segments`."""
    if segments < 1 or segments > 1024:
        raise DimensionError("draw_quadratic_bezier segments must be in [1, 1024]")
    prev_x: int = p0.x
    prev_y: int = p0.y
    i: int = 1
    while i <= segments:
        t: float = float(i) / float(segments)
        mt: float = 1.0 - t
        w0: float = mt * mt
        w1: float = 2.0 * mt * t
        w2: float = t * t
        nx: int = int(w0 * float(p0.x) + w1 * float(p1.x) + w2 * float(p2.x) + 0.5)
        ny: int = int(w0 * float(p0.y) + w1 * float(p1.y) + w2 * float(p2.y) + 0.5)
        draw_line(canvas, prev_x, prev_y, nx, ny, color, thickness, antialias)
        prev_x = nx
        prev_y = ny
        i = i + 1

def draw_cubic_bezier(canvas: Canvas, p0: Point2D, p1: Point2D, p2: Point2D, p3: Point2D, color: Pixel, thickness: int, segments: int, antialias: bool) -> None:
    """Draw a cubic Bezier curve from `p0` to `p3` with control points `p1, p2` subdivided into `segments`."""
    if segments < 1 or segments > 1024:
        raise DimensionError("draw_cubic_bezier segments must be in [1, 1024]")
    prev_x: int = p0.x
    prev_y: int = p0.y
    i: int = 1
    while i <= segments:
        t: float = float(i) / float(segments)
        mt: float = 1.0 - t
        w0: float = mt * mt * mt
        w1: float = 3.0 * mt * mt * t
        w2: float = 3.0 * mt * t * t
        w3: float = t * t * t
        nx: int = int(w0 * float(p0.x) + w1 * float(p1.x) + w2 * float(p2.x) + w3 * float(p3.x) + 0.5)
        ny: int = int(w0 * float(p0.y) + w1 * float(p1.y) + w2 * float(p2.y) + w3 * float(p3.y) + 0.5)
        draw_line(canvas, prev_x, prev_y, nx, ny, color, thickness, antialias)
        prev_x = nx
        prev_y = ny
        i = i + 1
