from prism import DEFAULT_TILE_SIZE, ExecutionPlan, GrayscaleMode, Image, MutableImage, PipelineGraph, Pixel, PixelFormat, PlanCache, ResourceLimits, execute_graph_eager, execute_pipeline_cached, optimize_pipeline

lim: ResourceLimits = ResourceLimits.default()
mut_img: MutableImage = MutableImage.create(32, 32, PixelFormat.RGBA8, Pixel.transparent(), lim)
y: int = 0
while y < 32:
    x: int = 0
    while x < 32:
        mut_img.set_pixel(x, y, Pixel.rgba(x * 8 & 255, y * 8 & 255, (x + y) * 4 & 255, 255))
        x = x + 1
    y = y + 1
src: Image = mut_img.to_image()

# Build deferred immutable PipelineGraph containing redundant algebraic patterns
g: PipelineGraph = PipelineGraph.empty()
g = g.flip_horizontal()
g = g.flip_horizontal()
g = g.crop(2, 2, 28, 28)
g = g.crop(2, 2, 24, 24)
g = g.gaussian_blur(1.0, 1)
g = g.sharpen(0.5)
g = g.grayscale(GrayscaleMode.SRGB_LUMA)

plan: ExecutionPlan = optimize_pipeline(g)
assert plan.original_count == 7 and len(plan.optimized_nodes) == 4, "planner fused 7 nodes into 4"

cache: PlanCache = PlanCache.create(262144)
res1: Image = execute_pipeline_cached(src, g, 12, cache, "0.9.0")
res2: Image = execute_pipeline_cached(src, g, 12, cache, "0.9.0")
ref_eager: Image = execute_graph_eager(src, g)

assert res1.pixel_equals(ref_eager), "tiled optimized execution matches eager reference"
assert res2.pixel_equals(res1), "cached result matches computed result"
assert cache.misses == 1 and cache.hits == 1, "cache tracked 1 miss then 1 hit"
assert DEFAULT_TILE_SIZE == 256, "DEFAULT_TILE_SIZE == 256"

print("pipeline-demo-ok", res1.width(), res1.height(), plan.optimizations_applied, cache.hits)
