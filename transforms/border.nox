from core.errors import DimensionError
from core.image import Image, MutableImage
from core.limits import checked_add
from core.pixel import Pixel

__all__: list[str] = ["BorderMode", "sample_with_border", "pad_image", "pad_with_mode"]

enum BorderMode:
    CLAMP
    MIRROR
    WRAP
    CONSTANT

    def name(self) -> str:
        match self:
            case BorderMode.CLAMP:
                return "CLAMP"
            case BorderMode.MIRROR:
                return "MIRROR"
            case BorderMode.WRAP:
                return "WRAP"
            case BorderMode.CONSTANT:
                return "CONSTANT"

def _reflect_index(coord: int, size: int) -> int:
    if size <= 1:
        return 0
    c: int = coord
    period: int = 2 * size - 2
    c = c % period
    if c < 0:
        c = c + period
    if c >= size:
        c = period - c
    return c

def _wrap_index(coord: int, size: int) -> int:
    if size <= 1:
        return 0
    c: int = coord % size
    if c < 0:
        c = c + size
    return c

def sample_with_border(img: Image, x: int, y: int, mode: BorderMode, const_px: Pixel) -> Pixel:
    """Sample a pixel from img using the configured boundary handling mode."""
    w: int = img.width()
    h: int = img.height()
    if x >= 0 and x < w and y >= 0 and y < h:
        return img.get_pixel(x, y)

    match mode:
        case BorderMode.CONSTANT:
            return const_px
        case BorderMode.CLAMP:
            cx: int = x
            cy: int = y
            if cx < 0:
                cx = 0
            elif cx >= w:
                cx = w - 1
            if cy < 0:
                cy = 0
            elif cy >= h:
                cy = h - 1
            return img.get_pixel(cx, cy)
        case BorderMode.MIRROR:
            mx: int = _reflect_index(x, w)
            my: int = _reflect_index(y, h)
            return img.get_pixel(mx, my)
        case BorderMode.WRAP:
            wx: int = _wrap_index(x, w)
            wy: int = _wrap_index(y, h)
            return img.get_pixel(wx, wy)

def pad_image(img: Image, left: int, top: int, right: int, bottom: int, fill_px: Pixel) -> Image:
    """Pad an Image on all four sides with a constant fill Pixel."""
    return pad_with_mode(img, left, top, right, bottom, BorderMode.CONSTANT, fill_px)

def pad_with_mode(img: Image, left: int, top: int, right: int, bottom: int, mode: BorderMode, const_px: Pixel) -> Image:
    """Pad an Image on all four sides using CONSTANT, CLAMP, MIRROR, or WRAP border mode."""
    if left < 0 or top < 0 or right < 0 or bottom < 0:
        raise DimensionError("pad margins (left, top, right, bottom) must be non-negative")
    w: int = img.width()
    h: int = img.height()
    out_w: int = checked_add(checked_add(w, left), right)
    out_h: int = checked_add(checked_add(h, top), bottom)
    img.limits.validate_dimensions(out_w, out_h, img.bytes_per_pixel())

    out_mut: MutableImage = MutableImage.create(out_w, out_h, img.pixel_format(), const_px, img.limits)
    oy: int = 0
    while oy < out_h:
        sy: int = oy - top
        ox: int = 0
        while ox < out_w:
            sx: int = ox - left
            px: Pixel = sample_with_border(img, sx, sy, mode, const_px)
            out_mut.set_pixel(ox, oy, px)
            ox = ox + 1
        oy = oy + 1

    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res
