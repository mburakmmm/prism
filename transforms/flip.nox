from core.image import Image, MutableImage
from core.pixel import Pixel

__all__: list[str] = ["flip_horizontal", "flip_vertical", "transpose", "transverse"]

def flip_horizontal(img: Image) -> Image:
    """Mirror an Image left-to-right (exact pixel operation)."""
    w: int = img.width()
    h: int = img.height()
    out_mut: MutableImage = MutableImage.create(w, h, img.pixel_format(), Pixel.transparent(), img.limits)
    y: int = 0
    while y < h:
        x: int = 0
        while x < w:
            out_mut.set_pixel(w - 1 - x, y, img.get_pixel(x, y))
            x = x + 1
        y = y + 1
    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res

def flip_vertical(img: Image) -> Image:
    """Mirror an Image top-to-bottom (exact pixel operation)."""
    w: int = img.width()
    h: int = img.height()
    out_mut: MutableImage = MutableImage.create(w, h, img.pixel_format(), Pixel.transparent(), img.limits)
    y: int = 0
    while y < h:
        dst_y: int = h - 1 - y
        x: int = 0
        while x < w:
            out_mut.set_pixel(x, dst_y, img.get_pixel(x, y))
            x = x + 1
        y = y + 1
    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res

def transpose(img: Image) -> Image:
    """Reflect an Image across its main diagonal: dst(y, x) = src(x, y), swapping width and height."""
    w: int = img.width()
    h: int = img.height()
    out_mut: MutableImage = MutableImage.create(h, w, img.pixel_format(), Pixel.transparent(), img.limits)
    y: int = 0
    while y < h:
        x: int = 0
        while x < w:
            out_mut.set_pixel(y, x, img.get_pixel(x, y))
            x = x + 1
        y = y + 1
    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res

def transverse(img: Image) -> Image:
    """Reflect an Image across its anti-diagonal: dst(h - 1 - y, w - 1 - x) = src(x, y)."""
    w: int = img.width()
    h: int = img.height()
    out_mut: MutableImage = MutableImage.create(h, w, img.pixel_format(), Pixel.transparent(), img.limits)
    y: int = 0
    while y < h:
        x: int = 0
        while x < w:
            out_mut.set_pixel(h - 1 - y, w - 1 - x, img.get_pixel(x, y))
            x = x + 1
        y = y + 1
    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res
