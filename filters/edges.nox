import nox.mathx
from core.color import clamp_u8
from core.image import Image, MutableImage
from core.pixel import Pixel, PixelFormat
from filters.convolution import convolve
from transforms.border import BorderMode, sample_with_border

__all__: list[str] = ["sobel", "prewitt", "laplacian", "emboss"]

def _gradient_magnitude_3x3(img: Image, kx: list[int], ky: list[int]) -> Image:
    w: int = img.width()
    h: int = img.height()
    has_a: bool = img.pixel_format().has_alpha()
    out_fmt: PixelFormat = PixelFormat.GRAY8
    if has_a:
        out_fmt = PixelFormat.RGBA8

    const_zero: Pixel = Pixel.transparent()
    out_mut: MutableImage = MutableImage.create(w, h, out_fmt, const_zero, img.limits)

    y: int = 0
    while y < h:
        x: int = 0
        while x < w:
            gx: int = 0
            gy: int = 0
            dy: int = -1
            while dy <= 1:
                row_off: int = (dy + 1) * 3
                dx: int = -1
                while dx <= 1:
                    idx: int = row_off + (dx + 1)
                    lum: int = sample_with_border(img, x + dx, y + dy, BorderMode.CLAMP, const_zero).luma_srgb()
                    gx = gx + kx[idx] * lum
                    gy = gy + ky[idx] * lum
                    dx = dx + 1
                dy = dy + 1

            mag: int = clamp_u8(int(nox.mathx.sqrt(float(gx * gx + gy * gy)) + 0.5))
            if has_a:
                out_mut.set_pixel(x, y, Pixel.rgba(mag, mag, mag, img.get_pixel(x, y).a))
            else:
                out_mut.set_pixel(x, y, Pixel.gray(mag))
            x = x + 1
        y = y + 1

    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res

def sobel(img: Image) -> Image:
    """Compute 3x3 Sobel edge gradient magnitude sqrt(Gx^2 + Gy^2) on perceptual luma."""
    kx: list[int] = [-1, 0, 1, -2, 0, 2, -1, 0, 1]
    ky: list[int] = [-1, -2, -1, 0, 0, 0, 1, 2, 1]
    return _gradient_magnitude_3x3(img, kx, ky)

def prewitt(img: Image) -> Image:
    """Compute 3x3 Prewitt edge gradient magnitude sqrt(Gx^2 + Gy^2) on perceptual luma."""
    kx: list[int] = [-1, 0, 1, -1, 0, 1, -1, 0, 1]
    ky: list[int] = [-1, -1, -1, 0, 0, 0, 1, 1, 1]
    return _gradient_magnitude_3x3(img, kx, ky)

def laplacian(img: Image) -> Image:
    """Compute 3x3 4-neighbor Laplacian second-derivative edge response."""
    kernel: list[float] = [0.0, -1.0, 0.0, -1.0, 4.0, -1.0, 0.0, -1.0, 0.0]
    return convolve(img, kernel, 3, 3, 1.0, 0.0, BorderMode.CLAMP)

def emboss(img: Image) -> Image:
    """Apply a 3x3 directional relief emboss filter centered around bias 128."""
    kernel: list[float] = [-2.0, -1.0, 0.0, -1.0, 0.0, 1.0, 0.0, 1.0, 2.0]
    return convolve(img, kernel, 3, 3, 1.0, 128.0, BorderMode.CLAMP)
