import nox.bytes
import nox.test
from nox.binary import BinaryWriter
from nox.buffer import Buffer
from prism import CorruptDataError, DecodeOptions, EncodeOptions, Image, ImageInfo, MutableImage, Pixel, PixelFormat, ResourceLimitError, ResourceLimits, UnsupportedFormatError, UnsupportedPixelFormatError, adler32_bytes, crc32_bytes, crc32_span, decode, decode_png, encode, encode_png, paeth_predictor, probe, probe_png, zlib_compress, zlib_decompress

def _make_chunk(ctype: str, payload: list[int]) -> list[int]:
    plen: int = len(payload)
    buf: Buffer = Buffer(12 + plen)
    w: BinaryWriter = BinaryWriter(buf)
    w.write_u32_be(u32(plen))
    tb: Buffer = nox.bytes.from_str(ctype)
    w.write_u8(tb.get(0))
    w.write_u8(tb.get(1))
    w.write_u8(tb.get(2))
    w.write_u8(tb.get(3))
    i: int = 0
    while i < plen:
        w.write_u8(u8(payload[i]))
        i = i + 1
    crc: int = crc32_span(buf, 4, 4 + plen)
    w.write_u32_be(u32(crc))
    return nox.bytes.to_list(buf)

def _build_custom_png(width: int, height: int, bit_depth: int, color_type: int, interlace: int, plte: list[int], trns: list[int], raw_scanlines: list[int], split_idat: bool) -> Buffer:
    out: list[int] = [137, 80, 78, 71, 13, 10, 26, 10]
    ihdr: list[int] = [width >> 24 & 255, width >> 16 & 255, width >> 8 & 255, width & 255, height >> 24 & 255, height >> 16 & 255, height >> 8 & 255, height & 255, bit_depth, color_type, 0, 0, interlace]
    ihdr_c: list[int] = _make_chunk("IHDR", ihdr)
    i: int = 0
    while i < len(ihdr_c):
        out.append(ihdr_c[i])
        i = i + 1

    if len(plte) > 0:
        plte_c: list[int] = _make_chunk("PLTE", plte)
        i = 0
        while i < len(plte_c):
            out.append(plte_c[i])
            i = i + 1

    if len(trns) > 0:
        trns_c: list[int] = _make_chunk("tRNS", trns)
        i = 0
        while i < len(trns_c):
            out.append(trns_c[i])
            i = i + 1

    scan_buf: Buffer = nox.bytes.from_list(raw_scanlines)
    zbuf: Buffer = zlib_compress(scan_buf)
    zlist: list[int] = nox.bytes.to_list(zbuf)

    if split_idat and len(zlist) >= 4:
        mid: int = len(zlist) // 2
        part1: list[int] = []
        part2: list[int] = []
        k: int = 0
        while k < mid:
            part1.append(zlist[k])
            k = k + 1
        while k < len(zlist):
            part2.append(zlist[k])
            k = k + 1
        c1: list[int] = _make_chunk("IDAT", part1)
        c2: list[int] = _make_chunk("IDAT", part2)
        i = 0
        while i < len(c1):
            out.append(c1[i])
            i = i + 1
        i = 0
        while i < len(c2):
            out.append(c2[i])
            i = i + 1
    else:
        idat_c: list[int] = _make_chunk("IDAT", zlist)
        i = 0
        while i < len(idat_c):
            out.append(idat_c[i])
            i = i + 1

    iend_c: list[int] = _make_chunk("IEND", [])
    i = 0
    while i < len(iend_c):
        out.append(iend_c[i])
        i = i + 1

    return nox.bytes.from_list(out)

def test_crc32_adler32_and_zlib_blocks() -> None:
    # IEEE 802.3 CRC-32 standard check value for "123456789" is 0xCBF43926 = 3421780262
    check_buf: Buffer = nox.bytes.from_str("123456789")
    nox.test.assert_eq_int(crc32_bytes(check_buf), 3421780262, "CRC-32 standard test vector")

    # RFC 1950 Adler-32 standard check value for "Wikipedia" is 0x11E60398 = 300286872
    wiki_buf: Buffer = nox.bytes.from_str("Wikipedia")
    nox.test.assert_eq_int(adler32_bytes(wiki_buf), 300286872, "Adler-32 standard test vector")

    # Zlib round-trip with repeated LZ77 patterns
    pattern_text: str = "Prism PNG Engine RFC1950/1951 test! Prism PNG Engine RFC1950/1951 test! AAAAAAAAAAAAAAAA"
    raw_in: Buffer = nox.bytes.from_str(pattern_text)
    comp: Buffer = zlib_compress(raw_in)
    decomp: Buffer = zlib_decompress(comp, 1024)
    nox.test.assert_eq_str(nox.bytes.to_str(decomp), pattern_text, "zlib LZ77+FixedHuffman roundtrip")

    # RFC 1951 Stored Block (BTYPE=00) test vector:
    # CMF=0x78, FLG=0x01, BFINAL=1|BTYPE=00 -> 0x01, LEN=4 (04 00), NLEN=0xFFFB (FB FF), "ABCD" (65,66,67,68), Adler32("ABCD") = 0x0298010B
    stored_zlib: Buffer = nox.bytes.from_list([120, 1, 1, 4, 0, 251, 255, 65, 66, 67, 68, 2, 152, 1, 11])
    stored_out: Buffer = zlib_decompress(stored_zlib, 64)
    nox.test.assert_eq_str(nox.bytes.to_str(stored_out), "ABCD", "DEFLATE stored block BTYPE=0")

    # RFC 1951 Dynamic Huffman (BTYPE=10) test vector generated by standard zlib for 240-byte payload ("A"*20 .. "L"*20)
    dyn_zlib: Buffer = nox.bytes.from_list([120, 218, 109, 193, 7, 1, 0, 32, 12, 0, 160, 108, 243, 206, 211, 63, 143, 1, 4, 34, 126, 5, 42, 52, 232, 48, 96, 66, 194, 130, 13, 7, 46, 60, 63, 142, 66, 25])
    dyn_out: Buffer = zlib_decompress(dyn_zlib, 512)
    nox.test.assert_eq_int(dyn_out.len(), 240, "DEFLATE dynamic Huffman block BTYPE=2 length")
    nox.test.assert_eq_int(int(dyn_out.get(0)), 65, "DEFLATE dynamic Huffman byte 0 ('A')")
    nox.test.assert_eq_int(int(dyn_out.get(239)), 76, "DEFLATE dynamic Huffman byte 239 ('L')")

def test_png_roundtrips_and_all_color_types() -> None:
    lim: ResourceLimits = ResourceLimits.default()

    # 1. GRAY8 round-trip (Color Type 0)
    mut_g: MutableImage = MutableImage.create(7, 5, PixelFormat.GRAY8, Pixel.black(), lim)
    gy: int = 0
    while gy < 5:
        gx: int = 0
        while gx < 7:
            mut_g.set_pixel(gx, gy, Pixel.gray(gx * 31 + gy * 43 & 255))
            gx = gx + 1
        gy = gy + 1
    src_g: Image = mut_g.to_image()
    png_g: Buffer = encode_png(src_g, EncodeOptions.default())
    info_g: ImageInfo = probe_png(png_g, DecodeOptions.default())
    nox.test.assert_eq_int(info_g.width, 7, "GRAY8 PNG probe width")
    nox.test.assert_eq_int(info_g.height, 5, "GRAY8 PNG probe height")
    nox.test.assert_eq_int(info_g.channels(), 1, "GRAY8 PNG probe channels")
    dec_g: Image = decode(png_g, DecodeOptions.default())
    nox.test.assert_true(dec_g.pixel_equals(src_g), "GRAY8 PNG lossless round-trip")

    # 2. RGB8 round-trip (Color Type 2)
    mut_rgb: MutableImage = MutableImage.create(9, 7, PixelFormat.RGB8, Pixel.black(), lim)
    ry: int = 0
    while ry < 7:
        rx: int = 0
        while rx < 9:
            mut_rgb.set_pixel(rx, ry, Pixel.rgb(rx * 29 + ry * 11 & 255, rx * 53 + ry * 37 & 255, rx * 17 + ry * 71 & 255))
            rx = rx + 1
        ry = ry + 1
    src_rgb: Image = mut_rgb.to_image()
    png_rgb: Buffer = encode(src_rgb, "PNG", EncodeOptions.default())
    dec_rgb: Image = decode_png(png_rgb, DecodeOptions.default())
    nox.test.assert_true(dec_rgb.pixel_equals(src_rgb), "RGB8 PNG lossless round-trip")

    # 3. RGBA8 round-trip (Color Type 6)
    mut_rgba: MutableImage = MutableImage.create(8, 8, PixelFormat.RGBA8, Pixel.transparent(), lim)
    ay: int = 0
    while ay < 8:
        ax: int = 0
        while ax < 8:
            mut_rgba.set_pixel(ax, ay, Pixel.rgba(ax * 32 & 255, ay * 32 & 255, (ax + ay) * 20 & 255, (ax * 4 + ay) * 9 & 255))
            ax = ax + 1
        ay = ay + 1
    src_rgba: Image = mut_rgba.to_image()
    png_rgba: Buffer = encode_png(src_rgba, EncodeOptions.default())
    info_rgba: ImageInfo = probe(png_rgba, DecodeOptions.default())
    nox.test.assert_eq_str(info_rgba.format_name, "PNG", "RGBA8 PNG format_name")
    nox.test.assert_eq_int(info_rgba.channels(), 4, "RGBA8 PNG channels")
    dec_rgba: Image = decode(png_rgba, DecodeOptions.default())
    nox.test.assert_true(dec_rgba.pixel_equals(src_rgba), "RGBA8 PNG lossless round-trip")

    # 4. Color Type 3 (Indexed Palette + tRNS alpha) & split IDAT chunks
    # 2x1 image with palette: entry 0 = (255, 0, 0, alpha=128), entry 1 = (0, 255, 0, alpha=255)
    pal_png: Buffer = _build_custom_png(2, 1, 8, 3, 0, [255, 0, 0, 0, 255, 0], [128], [0, 0, 1], True)
    dec_pal: Image = decode_png(pal_png, DecodeOptions.default())
    nox.test.assert_true(dec_pal.get_pixel(0, 0).equals(Pixel.rgba(255, 0, 0, 128)), "Color Type 3 PLTE+tRNS entry 0")
    nox.test.assert_true(dec_pal.get_pixel(1, 0).equals(Pixel.rgba(0, 255, 0, 255)), "Color Type 3 PLTE+tRNS entry 1")

    # 5. Color Type 4 (Grayscale + Alpha 8-bit)
    # 2x1 image: pixel 0 = (gray=50, alpha=200), pixel 1 = (gray=180, alpha=40)
    ga_png: Buffer = _build_custom_png(2, 1, 8, 4, 0, [], [], [0, 50, 200, 180, 40], False)
    dec_ga: Image = decode_png(ga_png, DecodeOptions.default())
    nox.test.assert_true(dec_ga.get_pixel(0, 0).equals(Pixel.rgba(50, 50, 50, 200)), "Color Type 4 Gray+Alpha pixel 0")
    nox.test.assert_true(dec_ga.get_pixel(1, 0).equals(Pixel.rgba(180, 180, 180, 40)), "Color Type 4 Gray+Alpha pixel 1")

def test_all_5_scanline_filters_explicitly() -> None:
    """Test explicit PNG scanlines using filters 0 (None), 1 (Sub), 2 (Up), 3 (Average), 4 (Paeth)."""
    # 2x5 Grayscale 8-bit image where row y uses filter_type = y (0..4):
    # Target unfiltered rows:
    # row 0 (filter 0 None):    [10, 25] -> filtered: [0, 10, 25]
    # row 1 (filter 1 Sub):     [30, 50] -> filtered: [1, 30, 20]
    # row 2 (filter 2 Up):      [40, 90] -> filtered: [2, 10, 40]
    # row 3 (filter 3 Average): [60, 110] -> row2=[40,90]:
    #   x=0: a=0, b=40, avg=20 -> filt=60-20=40
    #   x=1: a=60, b=90, avg=75 -> filt=110-75=35
    # row 4 (filter 4 Paeth):   [70, 130] -> row3=[60,110]:
    #   x=0: a=0, b=60, c=0 -> paeth=60 -> filt=70-60=10
    #   x=1: a=70, b=110, c=60 -> paeth(70,110,60)=110+70-60=120 -> pa=50,pb=10,pc=60 -> 110 -> filt=130-110=20
    nox.test.assert_eq_int(paeth_predictor(70, 110, 60), 110, "Paeth predictor check")
    raw_scans: list[int] = [0, 10, 25, 1, 30, 20, 2, 10, 40, 3, 40, 35, 4, 10, 20]
    filt_png: Buffer = _build_custom_png(2, 5, 8, 0, 0, [], [], raw_scans, False)
    img: Image = decode_png(filt_png, DecodeOptions.default())
    nox.test.assert_eq_int(img.get_pixel(0, 0).r, 10, "filter 0 (0,0)")
    nox.test.assert_eq_int(img.get_pixel(1, 0).r, 25, "filter 0 (1,0)")
    nox.test.assert_eq_int(img.get_pixel(0, 1).r, 30, "filter 1 (0,1)")
    nox.test.assert_eq_int(img.get_pixel(1, 1).r, 50, "filter 1 (1,1)")
    nox.test.assert_eq_int(img.get_pixel(0, 2).r, 40, "filter 2 (0,2)")
    nox.test.assert_eq_int(img.get_pixel(1, 2).r, 90, "filter 2 (1,2)")
    nox.test.assert_eq_int(img.get_pixel(0, 3).r, 60, "filter 3 (0,3)")
    nox.test.assert_eq_int(img.get_pixel(1, 3).r, 110, "filter 3 (1,3)")
    nox.test.assert_eq_int(img.get_pixel(0, 4).r, 70, "filter 4 (0,4)")
    nox.test.assert_eq_int(img.get_pixel(1, 4).r, 130, "filter 4 (1,4)")

def test_png_security_and_negative_cases() -> None:
    valid_png: Buffer = _build_custom_png(2, 2, 8, 0, 0, [], [], [0, 1, 2, 0, 3, 4], False)

    # 1. Corrupted CRC-32
    bad_crc_buf: Buffer = Buffer(valid_png.len())
    bad_crc_buf.copy_from(valid_png)
    # Flip a bit in IHDR CRC (offset 8 + 8 + 13 = 29)
    bad_crc_buf.set(29, u8(int(bad_crc_buf.get(29)) ^ 255))
    c_crc: bool = False
    try:
        decode_png(bad_crc_buf, DecodeOptions.default())
    except CorruptDataError:
        c_crc = True
    nox.test.assert_true(c_crc, "corrupted PNG chunk CRC-32 rejected")

    # 2. 16-bit PNG raises UnsupportedPixelFormatError in 8-bit core
    png16: Buffer = _build_custom_png(1, 1, 16, 2, 0, [], [], [0, 255, 0, 0, 0, 0, 0], False)
    c_16: bool = False
    try:
        decode_png(png16, DecodeOptions.default())
    except UnsupportedPixelFormatError:
        c_16 = True
    nox.test.assert_true(c_16, "16-bit PNG raises UnsupportedPixelFormatError")

    # 3. Adam7 interlaced PNG (interlace=1) raises UnsupportedFormatError
    png_adam7: Buffer = _build_custom_png(2, 2, 8, 0, 1, [], [], [0, 1, 2, 0, 3, 4], False)
    c_adam7: bool = False
    try:
        decode_png(png_adam7, DecodeOptions.default())
    except UnsupportedFormatError:
        c_adam7 = True
    nox.test.assert_true(c_adam7, "Adam7 interlaced PNG raises UnsupportedFormatError")

    # 4. Invalid scanline filter type (filter = 9)
    bad_filt_png: Buffer = _build_custom_png(2, 1, 8, 0, 0, [], [], [9, 10, 20], False)
    c_filt: bool = False
    try:
        decode_png(bad_filt_png, DecodeOptions.default())
    except CorruptDataError:
        c_filt = True
    nox.test.assert_true(c_filt, "invalid PNG scanline filter type 9 rejected")

    # 5. Color Type 3 missing PLTE chunk
    no_plte_png: Buffer = _build_custom_png(2, 1, 8, 3, 0, [], [], [0, 0, 0], False)
    c_no_plte: bool = False
    try:
        decode_png(no_plte_png, DecodeOptions.default())
    except CorruptDataError:
        c_no_plte = True
    nox.test.assert_true(c_no_plte, "indexed PNG without PLTE rejected")

    # 6. Out-of-bounds palette index in IDAT
    oob_pal_png: Buffer = _build_custom_png(2, 1, 8, 3, 0, [255, 0, 0], [], [0, 0, 5], False)
    c_oob_pal: bool = False
    try:
        decode_png(oob_pal_png, DecodeOptions.default())
    except CorruptDataError:
        c_oob_pal = True
    nox.test.assert_true(c_oob_pal, "out-of-bounds palette index in IDAT rejected")

    # 7. Decompression bomb: IDAT inflates to more bytes than scanline budget allows
    bomb_scans: list[int] = []
    bi: int = 0
    while bi < 500:
        bomb_scans.append(0)
        bi = bi + 1
    bomb_png: Buffer = _build_custom_png(2, 2, 8, 0, 0, [], [], bomb_scans, False)
    c_bomb: bool = False
    try:
        decode_png(bomb_png, DecodeOptions.default())
    except ResourceLimitError:
        c_bomb = True
    nox.test.assert_true(c_bomb, "PNG IDAT decompression bomb exceeding scanline budget rejected")

test_crc32_adler32_and_zlib_blocks()
test_png_roundtrips_and_all_color_types()
test_all_5_scanline_filters_explicitly()
test_png_security_and_negative_cases()
print("png_test-ok")
