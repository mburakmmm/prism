from core.errors import DimensionError, ResourceLimitError
from core.image import Image, MutableImage
from core.pixel import Pixel
from transforms.border import BorderMode, sample_with_border

MAX_MEDIAN_RADIUS: int = 5

def _median_from_values(vals: list[int]) -> int:
    # Insertion sort on small window (up to 11x11 = 121 elements)
    n: int = len(vals)
    i: int = 1
    while i < n:
        key: int = vals[i]
        j: int = i - 1
        while j >= 0 and vals[j] > key:
            vals[j + 1] = vals[j]
            j = j - 1
        vals[j + 1] = key
        i = i + 1
    return vals[n // 2]

def median_filter(img: Image, radius: int) -> Image:
    """Apply a (2*radius + 1) x (2*radius + 1) non-linear median filter per RGB channel."""
    if radius < 1:
        raise DimensionError("median_filter radius must be >= 1: got " + str(radius))
    if radius > MAX_MEDIAN_RADIUS:
        raise ResourceLimitError("median_filter radius " + str(radius) + " exceeds MAX_MEDIAN_RADIUS " + str(MAX_MEDIAN_RADIUS))

    w: int = img.width()
    h: int = img.height()
    const_zero: Pixel = Pixel.transparent()
    out_mut: MutableImage = MutableImage.create(w, h, img.pixel_format(), const_zero, img.limits)

    y: int = 0
    while y < h:
        x: int = 0
        while x < w:
            r_vals: list[int] = []
            g_vals: list[int] = []
            b_vals: list[int] = []
            dy: int = -radius
            while dy <= radius:
                dx: int = -radius
                while dx <= radius:
                    px: Pixel = sample_with_border(img, x + dx, y + dy, BorderMode.CLAMP, const_zero)
                    r_vals.append(px.r)
                    g_vals.append(px.g)
                    b_vals.append(px.b)
                    dx = dx + 1
                dy = dy + 1

            mr: int = _median_from_values(r_vals)
            mg: int = _median_from_values(g_vals)
            mb: int = _median_from_values(b_vals)
            out_mut.set_pixel(x, y, Pixel.rgba(mr, mg, mb, img.get_pixel(x, y).a))
            x = x + 1
        y = y + 1

    res: Image = out_mut.to_image()
    res.color_space = img.color_space
    res.alpha_mode = img.alpha_mode
    res.metadata = img.metadata.clone()
    return res
