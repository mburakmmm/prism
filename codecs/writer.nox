from nox.buffer import Buffer
from codecs.bmp import encode_bmp
from codecs.gif import encode_gif
from codecs.jpeg_adapter import JpegSubsampling, encode_jpeg
from codecs.pgm import encode_pgm
from codecs.png import encode_png
from codecs.ppm import encode_ppm
from codecs.sniff import ImageFormat, format_from_name
from codecs.tiff_adapter import encode_tiff
from codecs.webp_adapter import encode_webp
from core.errors import UnsupportedFormatError
from core.image import Image
from core.options import EncodeOptions

__all__: list[str] = ["encode_to_format", "encode_bytes"]

def encode_to_format(img: Image, fmt: ImageFormat, opt: EncodeOptions) -> Buffer:
    """Encode an Image into a Buffer using a typed ImageFormat target."""
    match fmt:
        case ImageFormat.PPM:
            return encode_ppm(img, opt)
        case ImageFormat.PGM:
            return encode_pgm(img, opt)
        case ImageFormat.BMP:
            return encode_bmp(img, opt)
        case ImageFormat.PNG:
            return encode_png(img, opt)
        case ImageFormat.GIF:
            return encode_gif(img, opt)
        case ImageFormat.JPEG:
            return encode_jpeg(img, opt, JpegSubsampling.S420)
        case ImageFormat.WEBP:
            return encode_webp(img, opt)
        case ImageFormat.TIFF:
            return encode_tiff(img, opt)
        case _:
            raise UnsupportedFormatError("cannot encode to UNKNOWN image format")

def encode_bytes(img: Image, format_name: str, opt: EncodeOptions) -> Buffer:
    """Encode an Image into a Buffer for the requested format name ('PPM', 'PGM', 'BMP', 'PNG', 'GIF')."""
    fmt: ImageFormat = format_from_name(format_name)
    return encode_to_format(img, fmt, opt)
